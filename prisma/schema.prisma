// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

// Two auth paths land in the same table:
// - Supabase-authenticated regular users: id is the Supabase auth UID,
//   email is set, username/passwordHash are null.
// - Locally-authenticated admins (Super Admin, future Admins): id is a
//   generated UUID, username/passwordHash are set, email is optional.
// Every future life-area model (tasks, habits, journal, finance, ...)
// hangs off this via userId, regardless of which path a user came from.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  role         UserRole @default(USER)
  name         String?
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks                Task[]
  projects             Project[]
  clients              Client[]
  meetings             Meeting[]
  workDocuments        WorkDocument[]
  workAiCaches         WorkAiCache[]
  workReports          WorkReport[]
  dailyHealthLogs      DailyHealthLog[]
  workouts             Workout[]
  nutritionEntries     NutritionEntry[]
  medicalRecords       MedicalRecord[]
  healthAiCaches       HealthAiCache[]
  healthReports        HealthReport[]
  comments             Comment[]
  quickNote            QuickNote?
  taskAiCaches         TaskAiCache[]
  taskReports          TaskReport[]
  habits               Habit[]
  habitCategories      HabitCategory[]
  habitAchievements    HabitAchievement[]
  journalEntries       JournalEntry[]
  journalAiCaches      JournalAiCache[]
  journalReports       JournalReport[]
  financialAccounts    FinancialAccount[]
  transactions         Transaction[]
  recurringPayments    RecurringPayment[]
  budgets              Budget[]
  savingsGoals         SavingsGoal[]
  investments          Investment[]
  assetsLiabilities    AssetLiability[]
  netWorthSnapshots    NetWorthSnapshot[]
  financialAiCaches    FinancialAiCache[]
  financialReports     FinancialReport[]
  sessions             Session[]
  studyLogs            StudyLog[]
  courses              Course[]
  books                Book[]
  certificates         Certificate[]
  learningAiCaches     LearningAiCache[]
  learningReports      LearningReport[]
  familyMembers        FamilyMember[]
  familyEvents         FamilyEvent[]
  giftIdeas            GiftIdea[]
  familyDocuments      FamilyDocument[]
  familyAiCaches       FamilyAiCache[]
  familyReports        FamilyReport[]
  trips                Trip[]
  bookings             Booking[]
  packingItems         PackingItem[]
  wishlistDestinations WishlistDestination[]
  travelAiCaches       TravelAiCache[]
  travelReports        TravelReport[]
  vaultItems           VaultItem[]
  vaultAiCaches        VaultAiCache[]
  vaultReports         VaultReport[]
}

// DB-backed sessions for locally-authenticated admin users. id stores a
// SHA-256 hash of the session token — the raw token only ever lives in
// the httpOnly cookie, so a DB read alone can't be replayed as a session.
model Session {
  id        String   @id
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING
  SOMEDAY
  DONE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  SOMEDAY_PRIORITY
}

enum EnergyLevel {
  VERY_LOW
  LOW
  MEDIUM
  HIGH
  DEEP_FOCUS
}

enum ProjectKind {
  PERSONAL
  WORK
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// Per-user contact for Work projects - name-only records are fine (not
// every client needs full CRM detail), archived rather than deleted so
// past projects keep a working client reference.
model Client {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  company   String?
  email     String?
  phone     String?
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  meetings  Meeting[]
  documents WorkDocument[]

  @@index([userId, archived])
}

// The same Project already used by Tasks, extended with Work-specific
// fields rather than a parallel WorkProject model - kind distinguishes a
// personal Tasks-module project from one that shows up in the Work
// dashboard, so both modules share one project/task system instead of
// fragmenting into two.
model Project {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  color       String
  kind        ProjectKind   @default(PERSONAL)
  description String?
  status      ProjectStatus @default(ACTIVE)
  deadline    DateTime?     @db.Date
  budget      Decimal?      @db.Decimal(14, 2)
  clientId    String?       @db.Uuid
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  archived    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks     Task[]
  meetings  Meeting[]
  documents WorkDocument[]

  @@index([userId, archived])
  @@index([userId, kind])
}

// A logged meeting, not a calendar invite - no calendar integration
// exists in this app yet, so this is a record of what happened/will
// happen rather than a scheduling system.
model Meeting {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  projectId       String?  @db.Uuid
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId        String?  @db.Uuid
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  startTime       DateTime
  durationMinutes Int?
  location        String?
  attendees       String[] @default([])
  notes           String?
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, startTime])
}

// Lightweight document record (title + optional external link), not a
// file upload - real file storage is deliberately deferred to the future
// Knowledge Vault phase; this just tracks "where the document lives".
model WorkDocument {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  url         String?
  projectId   String?  @db.Uuid
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId    String?  @db.Uuid
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// Same shape and purpose as TaskAiCache/JournalAiCache/FinancialAiCache:
// caches the Work dashboard's AI daily insight once per day.
model WorkAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

// User-triggered daily/weekly/monthly/yearly report, same pattern as
// TaskReport/JournalReport/FinancialReport.
model WorkReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}

// The daily-scalar trackers (weight/water/sleep/wellbeing) live on one
// row per user per day rather than four separate models - they're a
// single quick check-in, not independent events like a workout or a
// medical appointment. All fields are nullable since a day can log just
// one or two of them.
model DailyHealthLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  weightKg       Decimal? @db.Decimal(5, 2)
  waterMl        Int?
  sleepHours     Decimal? @db.Decimal(3, 1)
  sleepQuality   Int? // 1-5
  wellbeingScore Int? // 1-10
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
}

// Free-text type (not an enum) with UI-suggested presets - exercise
// variety is too open-ended for a fixed list. performedAt is a full
// timestamp (not just a date) since more than one workout can happen the
// same day, same reasoning as Meeting.startTime.
model Workout {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  performedAt     DateTime
  durationMinutes Int?
  caloriesBurned  Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, performedAt])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

// A lightweight meal log (description + optional calories) - not a food
// database with macros, which is its own product. Matches the "log what
// happened, don't model the whole domain" scope of Work's documents.
model NutritionEntry {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealType    MealType
  description String
  calories    Int?
  loggedAt    DateTime
  createdAt   DateTime @default(now())

  @@index([userId, loggedAt])
}

enum MedicalRecordType {
  APPOINTMENT
  PRESCRIPTION
  TEST
  VACCINATION
  NOTE
}

// No file attachments - same deliberate deferral to the future Knowledge
// Vault phase as Work's documents; this is a lightweight record of what
// happened/is due, not a document store.
model MedicalRecord {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @db.Uuid
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         MedicalRecordType
  title        String
  provider     String?
  notes        String?
  date         DateTime          @db.Date
  followUpDate DateTime?         @db.Date
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId, date])
}

// Same shape and purpose as TaskAiCache/WorkAiCache: caches the Health
// dashboard's AI daily insight once per day.
model HealthAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

// User-triggered daily/weekly/monthly/yearly report, same pattern as
// TaskReport/WorkReport/FinancialReport.
model HealthReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}

// descriptionJson/descriptionText mirror JournalEntry's contentJson/
// contentText pattern - same TipTap doc + plain-text-mirror editor,
// reused directly from the Journal module.
// parentId/subtasks IS the checklist system - no separate model.
// progressPercent is only used when a task has no subtasks; with
// subtasks, progress is always computed from their completion, never
// stored (avoids the two ever disagreeing).
model Task {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @db.Uuid
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  descriptionJson     Json?
  descriptionText     String             @default("")
  status              TaskStatus         @default(TODO)
  priority            Priority           @default(MEDIUM)
  energy              EnergyLevel?
  dueDate             DateTime?
  reminderAt          DateTime?
  estimatedMinutes    Int?
  actualMinutes       Int?
  repeatInterval      RecurringInterval?
  projectId           String?            @db.Uuid
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentId            String?            @db.Uuid
  parent              Task?              @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks            Task[]             @relation("TaskSubtasks")
  progressPercent     Int?
  tags                String[]           @default([])
  pinned              Boolean            @default(false)
  archived            Boolean            @default(false)
  // Set by the per-task AI actions so a "suggested" badge can render
  // without recomputing - never applied automatically.
  aiSuggestedPriority Priority?
  aiSuggestedEnergy   EnergyLevel?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  comments Comment[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([parentId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([taskId])
}

// The right sidebar's scratchpad - one per user (upsert), not a list.
model QuickNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

// Same shape and purpose as JournalAiCache/FinancialAiCache: caches the
// AI daily insight / suggested-next-task once per day.
model TaskAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

// User-triggered daily/weekly/monthly review, same pattern as
// JournalReport/FinancialReport.
model TaskReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}

enum HabitTimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  ANYTIME
}

// CUSTOM uses customDays (0=Sun..6=Sat). "Specific dates" one-off
// scheduling (vs. a recurring pattern) is deliberately not supported -
// out of scope for v1, see HANDOVER.
enum HabitSchedule {
  DAILY
  WEEKDAYS
  WEEKENDS
  CUSTOM
}

enum HabitGoalType {
  ONCE
  MULTIPLE
  DURATION
}

enum HabitDifficulty {
  EASY
  MEDIUM
  HARD
}

enum HabitPriority {
  LOW
  MEDIUM
  HIGH
}

// Per-user custom tags (e.g. "Health", "Mindfulness") used for the
// category color dot/badge and the category-comparison analytics
// grouping - separate from a habit's own icon/color, which are set
// individually per habit rather than inherited from the category.
model HabitCategory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  icon      String   @default("🏷️")
  createdAt DateTime @default(now())

  habits Habit[]

  @@unique([userId, name])
}

model Habit {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @db.Uuid
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  icon             String          @default("✨")
  color            String          @default("#6366f1")
  categoryId       String?         @db.Uuid
  category         HabitCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  timeOfDay        HabitTimeOfDay  @default(ANYTIME)
  schedule         HabitSchedule   @default(DAILY)
  customDays       Int[]           @default([])
  goalType         HabitGoalType   @default(ONCE)
  // targetCount/targetUnit back MULTIPLE goals (e.g. "8 glasses");
  // estimatedMinutes doubles as the DURATION goal's target and as the
  // habit card's displayed estimated duration for other goal types.
  targetCount      Int?
  targetUnit       String?
  estimatedMinutes Int?
  difficulty       HabitDifficulty @default(MEDIUM)
  priority         HabitPriority   @default(MEDIUM)
  motivation       String?
  reward           String?
  // Reminder fields are stored for a future notification system - v1
  // only surfaces "next reminder" as text, no real push delivery yet.
  reminderEnabled  Boolean         @default(false)
  reminderTime     String?
  reminderSound    Boolean         @default(true)
  archived         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  logs         HabitLog[]
  achievements HabitAchievement[]

  @@index([userId, archived])
}

// One row per calendar day a habit was completed. The unique constraint
// on (habitId, date) both prevents double-logging and makes "toggle
// today" a simple create-or-delete. completedAt/value/note are nullable
// since pre-redesign rows have none of them - only used for logs created
// through the new UI (also means Early Bird/Night Owl achievement checks
// naturally skip old data instead of fabricating false timestamps).
model HabitLog {
  id          String    @id @default(uuid()) @db.Uuid
  habitId     String    @db.Uuid
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  completedAt DateTime?
  value       Int?
  note        String?
  createdAt   DateTime  @default(now())

  @@unique([habitId, date])
}

// Account-wide unlock events (not per-habit) - e.g. "7 Day Streak" fires
// once the first time any habit reaches a 7-day streak, not once per
// habit. habitId just records which habit triggered it, for display.
model HabitAchievement {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId    String?  @db.Uuid
  habit      Habit?   @relation(fields: [habitId], references: [id], onDelete: SetNull)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

enum Mood {
  AMAZING
  HAPPY
  CALM
  NEUTRAL
  SAD
  FRUSTRATED
  TIRED
  STRESSED
}

// contentJson is the TipTap document (source of truth for the editor);
// contentText is a plain-text mirror computed client-side via
// editor.getText(), used for search, word counts, and AI context so we
// never have to walk the TipTap JSON tree server-side.
model JournalEntry {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentJson     Json?
  contentText     String   @default("")
  mood            Mood?
  energyMorning   Int?
  energyAfternoon Int?
  energyEvening   Int?
  gratitude       String[] @default([])
  tags            String[] @default([])
  // Best-effort seconds the editor had focus while this entry was being
  // written (accumulated client-side, flushed on save) - not a fake
  // words-per-minute estimate.
  writingSeconds  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
}

// Caches AI-generated content that's shown passively on every page load
// (Today Card's reflection, the Insights card) so they regenerate at most
// once per calendar day instead of on every request.
model JournalAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

enum ReportPeriod {
  DAY
  WEEK
  MONTH
  YEAR
}

// User-triggered (no scheduler in this app) weekly/monthly AI reflection.
// summary shape is enforced by a Zod schema at the call site, not by
// individual columns, so the AI output can evolve without a migration.
model JournalReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  LOAN
}

model FinancialAccount {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         AccountType
  balance      Decimal     @db.Decimal(14, 2)
  creditLimit  Decimal?    @db.Decimal(14, 2)
  interestRate Float?
  currency     String      @default("AUD")
  archived     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  transactions Transaction[]

  @@index([userId, archived])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model Transaction {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String           @db.Uuid
  account     FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Decimal          @db.Decimal(14, 2)
  currency    String           @default("AUD")
  category    String
  description String?
  date        DateTime
  tags        String[]         @default([])
  // Set when this row was generated from a RecurringPayment - lets us
  // avoid double-generating the same occurrence.
  recurringId String?          @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, date])
  @@index([accountId])
}

enum RecurringInterval {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// Bills/subscriptions/recurring income. The financial calendar projects
// upcoming occurrences forward from nextDueDate by interval at render
// time rather than materializing every future row.
model RecurringPayment {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  amount      Decimal           @db.Decimal(14, 2)
  currency    String            @default("AUD")
  type        TransactionType
  category    String
  interval    RecurringInterval
  nextDueDate DateTime          @db.Date
  autoPay     Boolean           @default(false)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, active])
}

// One row per category per month. Yearly comparison aggregates the
// twelve monthly rows rather than needing a separate yearly table.
model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String
  monthlyLimit Decimal  @db.Decimal(14, 2)
  month        DateTime @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category, month])
}

model SavingsGoal {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  targetAmount    Decimal   @db.Decimal(14, 2)
  currentAmount   Decimal   @default(0) @db.Decimal(14, 2)
  targetDate      DateTime? @db.Date
  linkedAccountId String?   @db.Uuid
  // Flags the one goal the health score checks for emergency-fund
  // coverage - not a separate model, just a distinguished SavingsGoal.
  isEmergencyFund Boolean   @default(false)
  archived        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, archived])
}

enum InvestmentType {
  SHARES
  ETF
  CRYPTO
  PROPERTY
  SUPERANNUATION
  OTHER
}

// currentValue is manually updated in this phase - no live market data
// feed yet (see plan: deferred to a follow-up pass).
model Investment {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         InvestmentType
  units        Decimal?       @db.Decimal(18, 6)
  costBasis    Decimal        @db.Decimal(14, 2)
  currentValue Decimal        @db.Decimal(14, 2)
  currency     String         @default("AUD")
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
}

enum AssetLiabilityKind {
  ASSET
  LIABILITY
}

// Catch-all for anything not already a FinancialAccount or Investment
// (a car, jewelry, a personal loan not modeled as an account).
model AssetLiability {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AssetLiabilityKind
  name      String
  category  String
  value     Decimal            @db.Decimal(14, 2)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, kind])
}

// Upserted once per day (lazily, on dashboard load) - powers the net
// worth trend chart without needing a cron job, same pattern as the
// once-per-day AI caches.
model NetWorthSnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  netWorth         Decimal  @db.Decimal(14, 2)
  totalAssets      Decimal  @db.Decimal(14, 2)
  totalLiabilities Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  @@unique([userId, date])
}

// Same shape and purpose as JournalAiCache: caches the cash-flow,
// spending-insights, and health-score AI narratives once per day.
model FinancialAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

// User-triggered daily/weekly/monthly/yearly report. summary shape is
// enforced by a Zod schema at the call site, same as JournalReport.
model FinancialReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}

// One row per user per day - a single quick check-in (minutes studied,
// how focused it felt), same "one row, not N independent events" shape
// as DailyHealthLog.
model StudyLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  minutesStudied Int?
  focusScore     Int? // 1-5, how focused/productive the session felt
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, date])
}

enum CourseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

model Course {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  provider        String?
  status          CourseStatus @default(NOT_STARTED)
  progressPercent Int          @default(0)
  startedAt       DateTime?    @db.Date
  completedAt     DateTime?    @db.Date
  url             String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, status])
}

enum BookStatus {
  WANT_TO_READ
  READING
  FINISHED
  ABANDONED
}

// A lightweight reading log (title/author/progress/rating) - not a full
// library catalog with editions/ISBNs, same "log what happened, don't
// model the whole domain" scope as Health's NutritionEntry.
model Book {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  author      String?
  status      BookStatus @default(WANT_TO_READ)
  currentPage Int?
  totalPages  Int?
  rating      Int? // 1-5, set once finished
  startedAt   DateTime?  @db.Date
  finishedAt  DateTime?  @db.Date
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status])
}

// No file attachments (credential PDFs) - same deliberate deferral to the
// future Knowledge Vault phase as Work's documents and Health's medical
// records; expiryDate drives the same "upcoming" surfacing pattern as
// MedicalRecord.followUpDate.
model Certificate {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  issuer        String?
  issueDate     DateTime  @db.Date
  expiryDate    DateTime? @db.Date
  credentialUrl String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, issueDate])
}

model LearningAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

// User-triggered daily/weekly/monthly/yearly report, same pattern as
// HealthReport/WorkReport.
model LearningReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}

// The person, not an event - birthday lives here (one date, reused to
// derive "upcoming birthdays" rather than duplicated as a recurring
// FamilyEvent row). relationship is freeform text with UI-suggested
// presets, same "log what happened, don't model the whole domain"
// scope as Workout.type.
model FamilyMember {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String?
  birthday     DateTime? @db.Date
  photoUrl     String?
  notes        String?
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events    FamilyEvent[]
  giftIdeas GiftIdea[]
  documents FamilyDocument[]

  @@index([userId, archived])
}

// BIRTHDAY is deliberately not a variant here - it's derived from
// FamilyMember.birthday instead, so a birthday is never entered twice.
enum FamilyEventType {
  ANNIVERSARY
  HOLIDAY
  GATHERING
  OTHER
}

// A logged/planned event, not a calendar invite - same scope as Work's
// Meeting (no calendar integration exists in this app yet).
model FamilyEvent {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      FamilyEventType @default(OTHER)
  date      DateTime
  memberId  String?         @db.Uuid
  member    FamilyMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  location  String?
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([userId, date])
}

enum GiftIdeaStatus {
  IDEA
  PURCHASED
  GIVEN
}

model GiftIdea {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId  String         @db.Uuid
  member    FamilyMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  title     String
  occasion  String?
  price     Decimal?       @db.Decimal(10, 2)
  url       String?
  status    GiftIdeaStatus @default(IDEA)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, memberId])
}

// Lightweight document record (title + optional external link), not a
// file upload - same deliberate deferral to the future Knowledge Vault
// phase as Work's documents and Health's medical records.
model FamilyDocument {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  url         String?
  memberId    String?       @db.Uuid
  member      FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  tags        String[]      @default([])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
}

model FamilyAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

// User-triggered daily/weekly/monthly/yearly report, same pattern as
// WorkReport/HealthReport/LearningReport.
model FamilyReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}

enum TripStatus {
  PLANNING
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// The trip container - like Work's Project. notes doubles as the place
// for "travel memories" once a trip is COMPLETED, rather than a separate
// model - same "don't model the whole domain" scope as elsewhere. No
// photos - file storage is deliberately deferred everywhere in this app.
model Trip {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String
  country     String?
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date
  status      TripStatus @default(PLANNING)
  budget      Decimal?   @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  bookings     Booking[]
  packingItems PackingItem[]

  @@index([userId, status])
}

enum BookingType {
  FLIGHT
  HOTEL
  CAR_RENTAL
  ACTIVITY
  OTHER
}

// A logged reservation (flight/hotel/car/activity), not a live booking
// integration - no such integration exists in this app, same scope as
// Work's Meeting.
model Booking {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @db.Uuid
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId             String      @db.Uuid
  trip               Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type               BookingType
  title              String
  provider           String?
  confirmationNumber String?
  startAt            DateTime?
  endAt              DateTime?
  cost               Decimal?    @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId, tripId])
}

// A simple per-trip checklist item - not a packing-list template system.
model PackingItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tripId    String   @db.Uuid
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name      String
  category  String?
  packed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, tripId])
}

// Destinations not yet turned into a real Trip - a simple starred
// backlog, not linked to any Trip row.
model WishlistDestination {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination String
  country     String?
  notes       String?
  starred     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model TravelAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

// User-triggered daily/weekly/monthly/yearly report, same pattern as
// FamilyReport/WorkReport/HealthReport/LearningReport.
model TravelReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}

enum VaultItemType {
  NOTE
  LINK
}

// A single polymorphic model rather than parallel Note/Link/File models -
// the Vault is fundamentally one searchable, filterable list, not several
// domain entities like Work's Project/Client/Meeting. contentJson/
// contentText reuse JournalEntry's TipTap-doc + plain-text-mirror pattern
// (the mirror is what search filters against). NOTE items use both
// fields; LINK items only use contentText for an optional description.
// No file/PDF/image/video attachment yet - real file storage is
// deliberately deferred everywhere else in this app (Work/Health/
// Learning/Family/Travel all defer it too), and Vault will be the first
// to actually need it - a follow-up scope decision, not implicit scope
// creep here.
model VaultItem {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        VaultItemType
  title       String
  contentJson Json?
  contentText String        @default("")
  url         String?
  category    String?
  tags        String[]      @default([])
  favorited   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, type])
  @@index([userId, favorited])
}

model VaultAiCache {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  kind      String
  content   Json
  createdAt DateTime @default(now())

  @@unique([userId, date, kind])
}

// User-triggered daily/weekly/monthly/yearly report, same pattern as
// TravelReport/FamilyReport/WorkReport/HealthReport/LearningReport.
model VaultReport {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  period      ReportPeriod
  periodStart DateTime     @db.Date
  summary     Json
  createdAt   DateTime     @default(now())

  @@unique([userId, period, periodStart])
}
