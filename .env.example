# Database (Supabase connection strings — Settings → Database → Connection string)
# Transaction pooler (port 6543) — used by the running app
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-1-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) — used by `prisma db push` / `migrate`
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-1-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Supabase Auth (regular users)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Super Admin bootstrap (local auth, independent of Supabase) — only used
# by `npx prisma db seed`, and only to create the account if it doesn't
# already exist. Safe to unset after the first run.
SUPER_ADMIN_USERNAME=""
SUPER_ADMIN_PASSWORD=""

# AI providers - resolved in this order at request time, see
# src/lib/ai/providers.ts. Ollama only ever resolves on a machine actually
# running it (Vercel can't reach your localhost), so it's the local-dev
# default while production falls through to Anthropic/OpenAI automatically.
#
# Ollama (local, free, private) - no key needed, just run `ollama serve`
# OLLAMA_BASE_URL="http://localhost:11434"    # default, uncomment to override
# OLLAMA_MODEL="llama3.2:3b"                  # default, uncomment to override (e.g. "qwen3:8b")

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
