# Database (Supabase connection strings — Settings → Database → Connection string)
# Transaction pooler (port 6543) — used by the running app
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-1-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) — used by `prisma db push` / `migrate`
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-1-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI providers
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
